# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Phase 1: External data source credentials
# ---------------------------------------------------------------------------
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

NASA_FIRMS_MAP_KEY=

FRED_API_KEY=

# NOAA HURDAT2 is a public static file — no key required.

# ---------------------------------------------------------------------------
# Phase 3: Azure core infrastructure (introduced when Phase 3 begins)
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=climateguard-ai-rg
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_KEY_VAULT_NAME=
AZURE_DATABRICKS_WORKSPACE_URL=
AZURE_ML_WORKSPACE_NAME=

# ---------------------------------------------------------------------------
# Phase 9: Azure OpenAI + Azure AI Search (introduced when Phase 9 begins)
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=climateguard-rag-index

# ---------------------------------------------------------------------------
# Phase 10: Serving / deployment
# ---------------------------------------------------------------------------
API_ENV=local
API_LOG_LEVEL=INFO
